# Mobile app environment variables
EXPO_PUBLIC_API_URL=https://edis.dshub.com.ng/api

# YouTube Data API v3 key (https://console.cloud.google.com)
# Required for the Explore screen to fetch daily health videos directly.
# Without this the app falls back to the backend /explore/videos endpoint.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Firebase API key (https://console.firebase.google.com)
# Set FIREBASE_APIKey on the Render environment for production.
EXPO_PUBLIC_FIREBASE_API_KEY=


