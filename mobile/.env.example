# Mobile app environment variables
EXPO_PUBLIC_API_URL=https://edis.dshub.com.ng/api

# YouTube Data API v3 key (https://console.cloud.google.com)
# Required for the Explore screen to fetch daily health videos directly.
# Without this the app falls back to the backend /explore/videos endpoint.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Firebase API key (https://console.firebase.google.com)
# Set FIREBASE_APIKey on the Render environment for production.
EXPO_PUBLIC_FIREBASE_API_KEY=

# Legal document routes
EXPO_PUBLIC_TERMS_URL=https://mobile.dshub.com.ng/terms
EXPO_PUBLIC_PRIVACY_URL=https://mobile.dshub.com.ng/policy

# ── AdMob — Native App IDs (used by react-native-google-mobile-ads Expo plugin) ──
# These override the fallbacks in app.config.js at EAS build time.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-4516568539037938~3922174578
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-4516568539037938~3952077665

# ── AdMob — Native Banner Unit IDs ──
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-4516568539037938/4524809808
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-4516568539037938/1507250875

# ── AdMob — Native Rewarded Unit IDs ──
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_UNIT_ID=ca-app-pub-4516568539037938/1561718040
EXPO_PUBLIC_ADMOB_IOS_REWARDED_UNIT_ID=ca-app-pub-4516568539037938/4827548784

# ── AdSense — Web (adsbygoogle) ──
# Used by BannerAd.web.tsx and InterstitialAdSlot.web.tsx.
# All web units must be created at adsense.google.com → Ads → By ad unit.
# Do NOT use mobile AdMob unit IDs here — they will not serve on web.
EXPO_PUBLIC_ADMOB_WEB_PUBLISHER_ID=ca-pub-4516568539037938
# Display banner unit (Ads → By ad unit → Display ads → slot ID only, e.g. 8453139420)
EXPO_PUBLIC_ADMOB_WEB_BANNER_SLOT=8453139420
# Interstitial unit is optional — AdSense Auto Ads vignettes work without one.
# Enable "Auto ads → Vignettes" in your AdSense dashboard instead.
# If you create a dedicated interstitial unit, set it here (ca-pub-XXXX/SLOT_ID).
# EXPO_PUBLIC_ADMOB_WEB_INTERSTITIAL_UNIT_ID=ca-pub-4516568539037938/<YOUR_INTERSTITIAL_SLOT_ID>
#
# In-article fluid unit — rendered by RewardedAdButton.web.tsx in place of
# rewarded ads (no true rewarded ads on web AdSense; no reward is granted).
EXPO_PUBLIC_ADMOB_WEB_INARTICLE_SLOT=4158671196