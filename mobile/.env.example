# Mobile app environment variables
EXPO_PUBLIC_API_URL=https://edis.dshub.com.ng/api

# YouTube Data API v3 key (https://console.cloud.google.com)
# Required for the Explore screen to fetch daily health videos directly.
# Without this the app falls back to the backend /explore/videos endpoint.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Firebase API key (https://console.firebase.google.com)
# Set FIREBASE_APIKey on the Render environment for production.
EXPO_PUBLIC_FIREBASE_API_KEY=

# Legal document routes
EXPO_PUBLIC_TERMS_URL=https://mobile.dshub.com.ng/terms
EXPO_PUBLIC_PRIVACY_URL=https://mobile.dshub.com.ng/policy

# ── Ads ──
# All third-party ad SDKs (AdMob/AdSense) have been removed. Banner slots
# show LifeGate house ads (HouseAd.tsx); rewarded ads play self-hosted videos.
#
# ── Web rewarded videos (self-hosted) ──
# RewardedAdButton.web.tsx plays LifeGate promo videos and grants the reward
# on completion. Defaults to the bundled Google Drive links; override with a
# comma-separated list of direct video URLs:
# EXPO_PUBLIC_WEB_REWARDED_VIDEO_URLS=https://cdn.example.com/v1.mp4,https://cdn.example.com/v2.mp4