PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/lifegate?sslmode=disable
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=contact@dshub.com.ng
UPLOAD_DIR=./uploads

# YouTube Data API v3 — used for daily explore video refresh
YOUTUBE_DATA_API_KEY=your-youtube-data-api-key

# CORS — comma-separated list of allowed origins (leave empty to allow all in development)
# Example: ALLOWED_ORIGINS=https://edis.dshub.com.ng,https://yourdomain.com
ALLOWED_ORIGINS=

# Flutterwave — https://dashboard.flutterwave.com
# FLW_SECRET_KEY   : Secret key from your Flutterwave dashboard (starts with FLWSECK_...)
# FLW_PUBLIC_KEY   : Public key (FLWPUBK_...)
# FLW_REDIRECT_URL : After checkout Flutterwave redirects here.
#                    Native app: lifegate://payment/callback  (OS intercepts the deep-link)
#                    Web app   : https://edis.dshub.com.ng/payment-callback
#                    Set this to the web URL when the backend is serving web clients.
# FLW_WEBHOOK_HASH : The secret hash set in Flutterwave dashboard → Settings → Webhooks
#                    Used to verify that webhook calls originate from Flutterwave.
#                    Webhook URL to enter in the Flutterwave dashboard:
#                    https://edis.dshub.com.ng/api/payments/webhook
FLW_SECRET_KEY=FLWSECK_TEST-...
FLW_PUBLIC_KEY=FLWPUBK_TEST-...
FLW_REDIRECT_URL=https://edis.dshub.com.ng/payment-callback
FLW_WEBHOOK_HASH=your-webhook-secret-hash

# FX pricing for USD bundle display and checkout
# FX_RATE_URL should return a JSON payload with rates.NGN for USD base rates.
FX_RATE_URL=https://open.er-api.com/v6/latest/USD
FX_FALLBACK_NGN_PER_USD=1600
FX_CACHE_TTL=30m
